# =============================================================================
# CAPSERA — Shared Environment Configuration Example
# Copy to .env (or server/.env and client/.env) and adjust for local setup.
# Never commit real secrets or credentials to version control.
# =============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database (Required by Faculty; see docs/DECISIONS.md — ADR-002)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=capsera_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_CONNECTION_LIMIT=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
# Optional full connection URI override (if used in managed deployments):
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@127.0.0.1:5432/capsera_db

# Authentication & Security (Placeholders — pending Member 1 / Team Auth Decision)
JWT_SECRET=replace_with_a_strong_random_secret_in_local_env
SESSION_SECRET=replace_with_a_strong_random_secret_in_local_env

# Frontend (Vite exposes variables prefixed with VITE_)
VITE_API_BASE_URL=/api/v1
